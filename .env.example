# Copiar a .env y completar. Sin estas variables la app usa el backend LOCAL (localStorage).
# Backend: "local" | "supabase"
VITE_BACKEND=local

# Supabase (solo si VITE_BACKEND=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave del evento: se usa para firmar los tokens de las estaciones (antitrampa).
# Cambiarla el día del evento. Cualquier texto largo y aleatorio.
VITE_CLAVE_EVENTO=cambiar-esta-clave-antes-del-evento
